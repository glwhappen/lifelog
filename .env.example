# ---- 数据库（必填）----
DATABASE_URL=postgres://lifelog:lifelog@life-db:5432/lifelog

# ---- 登录：任意标准 OIDC 提供方（Authentik / Keycloak / Auth0 / 自建 Authentik…）----
# Authentik 的 issuer 形如 https://auth.example.com/application/o/<应用slug>/
OIDC_ISSUER=https://auth.example.com/application/o/lifelog/
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SCOPE=openid profile email

# 用来签名登录会话的随机串（必填，随便生成 32 位以上随机字符）
SESSION_SECRET=

# ---- 可选 ----
# 本地开发：未配置 OIDC 时允许匿名单机模式（生产不要开）
ALLOW_ANON=0
# 默认时区（用户可在设置页单独覆盖）
DEFAULT_TIMEZONE=Asia/Shanghai
# 逆地理编码：把经纬度换成地名。留空则只存坐标。
# 支持 {lat} {lng} 占位，例如 https://nominatim.openstreetmap.org/reverse?format=jsonv2&lat={lat}&lon={lng}
GEOCODE_URL=
# ---- 速记框的 AI 解析（可选；配了 key 就自动启用）----
# 不配也能用：输入框会退回「规则分流」（只认「午饭 35」这类有明显特征的说法）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# 关思考（对「理解一句话记个账」这种任务，思考纯属浪费：
# 实测同一句话开思考 238 tokens 且 content 为空，关掉后 25 tokens 且有正常回答）
AI_CAPTURE_ENABLED=1
AI_TIMEOUT_MS=45000
# 速记解析每分钟上限（每次都要花钱）
AI_RATE_PER_MIN=20
